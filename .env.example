DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
# For production use exact hosts, e.g. meters.example.com; * is for local dev only.
DJANGO_ALLOWED_HOSTS=*
# Comma-separated HTTPS origins for a reverse proxy, e.g. https://meters.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Moscow
APP_VERSION=1.2.0
# Image repository used by docker-compose.prod.yml, without the tag.
# For local images use multiregistrator-web; for GHCR use the repository below.
APP_IMAGE=ghcr.io/eljzx/multiregistrator-web
WEB_PORT=8080
POSTGRES_DB=multiregistrator
POSTGRES_USER=multiregistrator
POSTGRES_PASSWORD=multiregistrator
POSTGRES_PORT=5434
ARCHIVE_STORAGE=database
AUDIT_LOG_ENABLED=1
TESTDEVICE_PORT=5020
